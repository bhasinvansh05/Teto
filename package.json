{
  "name": "teto",
  "version": "0.1.0",
  "private": true,
  "description": "Teto — bidirectional ASL ↔ English communication",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:contracts": "npm run test -w @teto/contracts",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "demo": "npm run demo -w @teto/web"
  },
  "engines": {
    "node": ">=20"
  }
}
