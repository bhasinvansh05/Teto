{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teto.dev/schemas/animation-command.schema.json",
  "title": "AnimationCommand",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "commandId",
    "glossId",
    "playbackRate",
    "clips"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "commandId": { "type": "string", "minLength": 1 },
    "glossId": { "type": "string", "minLength": 1 },
    "playbackRate": { "type": "number", "exclusiveMinimum": 0 },
    "clips": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tokenId",
          "clipId",
          "startMs",
          "durationMs",
          "blendInMs",
          "blendOutMs"
        ],
        "properties": {
          "tokenId": { "type": "string", "minLength": 1 },
          "clipId": { "type": "string", "minLength": 1 },
          "startMs": { "type": "number", "minimum": 0 },
          "durationMs": { "type": "number", "minimum": 0 },
          "blendInMs": { "type": "number", "minimum": 0 },
          "blendOutMs": { "type": "number", "minimum": 0 },
          "poseOverrides": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          },
          "nmm": {
            "type": "object",
            "additionalProperties": false,
            "required": ["brow", "head", "eyeGaze"],
            "properties": {
              "brow": {
                "type": "string",
                "enum": ["neutral", "raised", "furrowed"]
              },
              "head": {
                "type": "string",
                "enum": [
                  "neutral",
                  "nod",
                  "shake",
                  "tilt-left",
                  "tilt-right",
                  "tilt-forward"
                ]
              },
              "eyeGaze": {
                "type": "string",
                "enum": ["forward", "left", "right", "up", "down"]
              }
            }
          }
        }
      }
    }
  }
}