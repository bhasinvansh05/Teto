{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teto.dev/schemas/sign-sequence.schema.json",
  "title": "SignSequence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sequenceId",
    "startedAtMs",
    "endedAtMs",
    "signs"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "sequenceId": { "type": "string", "minLength": 1 },
    "startedAtMs": { "type": "number", "minimum": 0 },
    "endedAtMs": { "type": "number", "minimum": 0 },
    "signs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "confidence",
          "startedAtMs",
          "endedAtMs",
          "stable"
        ],
        "properties": {
          "label": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9\\-]*$"
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "startedAtMs": { "type": "number", "minimum": 0 },
          "endedAtMs": { "type": "number", "minimum": 0 },
          "stable": { "type": "boolean" }
        }
      }
    }
  }
}
